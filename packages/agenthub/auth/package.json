{
  "name": "@agenthub/auth",
  "description": "AgentHub 平台身份（P1：dev 匿名 userId 中间件，不发 Cookie、不写 sessions 表；真登录 P2 收尾）",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@types/pg": "^8.15.0"
  },
  "dependencies": {
    "@agenthub/_shared": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "pg": "^8.16.0"
  }
}
