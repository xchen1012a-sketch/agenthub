{
  "name": "@agenthub/openapi-ingest",
  "description": "AgentHub OpenAPI 导入：OpenAPI 3.x paths → operation 级 Tool 草稿行（P3 方案书阶段 C T5）",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/schemastery": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@types/pg": "^8.15.0",
    "pg": "^8.13.0"
  },
  "dependencies": {
    "@agenthub/_shared": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:*"
  }
}