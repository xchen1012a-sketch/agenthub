{
  "name": "@agenthub/credential-vault",
  "description": "AgentHub 凭证 Vault：AES-256-GCM 加密落库 user_credentials，过期阻断 + credential.expired 事件（P3 方案书阶段 A T3）",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@types/pg": "^8.15.0",
    "pg": "^8.16.0"
  },
  "dependencies": {
    "@agenthub/_shared": "workspace:*"
  }
}
