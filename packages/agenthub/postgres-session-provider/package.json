{
  "name": "@agenthub/postgres-session-provider",
  "description": "AgentHub Session 持久化 Postgres Provider：实现 SessionPersistence 同一 service contract 落 PostgreSQL（P2 方案书 T8）",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@types/pg": "^8.15.0"
  },
  "dependencies": {
    "@agenthub/_shared": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:~",
    "@deepseek-ai/dsh-session-persistence": "workspace:~",
    "pg": "^8.15.0"
  }
}
